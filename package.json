{
  "name": "@local/textmode-pixel-theme",
  "version": "1.9.1",
  "private": true,
  "type": "module",
  "description": "Text-mode pixel-art theme for the whole Harness with seven looks (scene ink, phosphor CRT, amber VT, blueprint, vapor, paper, Game Boy) and 14 live ASCII wallpapers, all in monospace with square tiles and pixel scrollbars.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "docs/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "license": "MIT",
  "author": "GalaxyVN",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Galaxy-VN/dsh-pixel-themes.git"
  },
  "homepage": "https://github.com/Galaxy-VN/dsh-pixel-themes#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "theme",
    "pixel-art",
    "ascii",
    "cordis"
  ]
}
